{
  "name": "sandpost",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "^24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "crates/sandpost"
  ],
  "devDependencies": {
    "turbo": "^2.11.9"
  },
  "scripts": {
    "sandpost-cli:build": "turbo run build --filter=@sandpost/sandpost",
    "sandpost-cli:dev": "turbo run dev --filter=@sandpost/sandpost..."
  }
}
